# Copy to .dev.vars for local secrets. Wrangler loads .dev.vars and does not upload it.
# .dev.vars is gitignored. Do not put real keys in this example file.

# Optional. When set, Desk and Researcher use OpenAI instead of Workers AI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional override of the Workers AI model id (wrangler.jsonc already sets a default).
# WORKERS_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Optional. A Streamable HTTP MCP endpoint. Desk calls addMcpServer only when this is set.
# MCP_SERVER_URL=https://example.com/mcp

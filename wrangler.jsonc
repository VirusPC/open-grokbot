{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-grokbot",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/webhooks/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DeskAgent", "class_name": "DeskAgent" },
      { "name": "ResearcherAgent", "class_name": "ResearcherAgent" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeskAgent", "ResearcherAgent"]
    }
  ]
}
